---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publications } from "../../data/publications";
import { formatDateLabel, groupPublicationsByYear, publicationAnchor } from "../../lib/content";
import { siteData } from "../../data/site";
import { jonathanProfile } from "../../data/jonathan";

const groupedPublications = groupPublicationsByYear(publications);
const pdbUrl = (id: string) => `https://www.rcsb.org/structure/${id}`;
const emdbUrl = (id: string) => `https://www.ebi.ac.uk/emdb/${id}`;
const isPrimaryDestination = (link: string, primary: string) => {
  const left = new URL(link);
  const right = new URL(primary);
  return left.origin === right.origin && left.pathname.replace(/\/$/, "") === right.pathname.replace(/\/$/, "");
};
---

<BaseLayout
  title="Publications"
  description="Publication record for the Abraham Lab, including papers, preprints, structures, and public research resources."
  pageClass="page-publications"
  socialImage={siteData.shareImages.science.image}
  socialImageAlt={siteData.shareImages.science.alt}
  socialImageWidth={siteData.shareImages.science.width}
  socialImageHeight={siteData.shareImages.science.height}
  modifiedAt={siteData.publicationRecord.checkedAt}
>
  <section class="page-intro page-intro--publications">
    <div class="shell page-intro__grid">
      <div class="page-intro__copy reveal">
        <h1>Publications</h1>
      </div>
      <div class="page-intro__actions reveal">
        <p class="publication-status publication-status--intro">
          <span>Publications checked</span>
          <time datetime={siteData.publicationRecord.checkedAt}>{formatDateLabel(siteData.publicationRecord.checkedAt)}</time>
        </p>
        <a class="publication-pubmed-link" href={jonathanProfile.pubmedUrl} target="_blank" rel="noreferrer">
          Jonathan Abraham on PubMed <span aria-hidden="true">↗</span>
        </a>
        <button class="publication-print" type="button" onclick="window.print()">Print or save PDF</button>
      </div>
    </div>
  </section>

  <nav class="publication-index" aria-label="Publication years">
    <div class="shell publication-index__inner">
      <span>Jump to year</span>
      <ol>
        {groupedPublications.map((yearGroup) => (
          <li><a href={`#publications-${yearGroup.year}`}>{yearGroup.year}</a></li>
        ))}
      </ol>
    </div>
  </nav>

  <section class="publication-record" aria-label="Publication record">
    <div class="shell publication-record__list">
      {groupedPublications.map((yearGroup) => (
        <section class="publication-year" aria-labelledby={`publications-${yearGroup.year}`}>
          <h2 id={`publications-${yearGroup.year}`}>{yearGroup.year}</h2>
          <ol>
            {yearGroup.entries.map((item) => (
              <li class="publication-row reveal" id={publicationAnchor(item)}>
                <div class="publication-row__body">
                  <h3><a href={item.link} target="_blank" rel="noreferrer">{item.title}</a></h3>
                  <p class="publication-row__citation">{item.citation}</p>
                  {(item.structures || item.resourceLinks || item.coverageLinks) && (
                    <div class="publication-row__outputs" aria-label={`Research outputs for ${item.title}`}>
                      {item.structures?.pdb?.length && (
                        <div class="publication-output">
                          <span>PDB</span>
                          <ul>
                            {item.structures.pdb.map((id) => (
                              <li><a href={pdbUrl(id)} target="_blank" rel="noreferrer">{id}</a></li>
                            ))}
                          </ul>
                        </div>
                      )}
                      {item.structures?.emdb?.length && (
                        <div class="publication-output">
                          <span>EMDB</span>
                          <ul>
                            {item.structures.emdb.map((id) => (
                              <li><a href={emdbUrl(id)} target="_blank" rel="noreferrer">{id}</a></li>
                            ))}
                          </ul>
                        </div>
                      )}
                      {item.resourceLinks?.length && (
                        <div class="publication-output">
                          <span>Resources</span>
                          <ul>
                            {item.resourceLinks.map((resource) => (
                              <li><a href={resource.href} target="_blank" rel="noreferrer">{resource.label}</a></li>
                            ))}
                          </ul>
                        </div>
                      )}
                      {item.coverageLinks?.length && (
                        <div class="publication-output">
                          <span>Coverage</span>
                          <ul>
                            {item.coverageLinks.map((href) => (
                              <li><a href={href} target="_blank" rel="noreferrer">Harvard Medical School</a></li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </div>
                  )}
                </div>
                <div class="publication-row__meta">
                  {item.journal && <strong>{item.journal}</strong>}
                  <span class:list={["publication-row__type", item.articleType === "Preprint" && "publication-row__type--preprint"]}>{item.articleType}</span>
                  {item.openAccess && <span class="publication-row__access">Open access</span>}
                  <div class="publication-row__links">
                    {item.pmid && !isPrimaryDestination(`https://pubmed.ncbi.nlm.nih.gov/${item.pmid}/`, item.link) && <a href={`https://pubmed.ncbi.nlm.nih.gov/${item.pmid}/`} target="_blank" rel="noreferrer" aria-label={`PubMed: ${item.title}`}>PubMed</a>}
                    {item.pmcid && !isPrimaryDestination(`https://pmc.ncbi.nlm.nih.gov/articles/${item.pmcid}/`, item.link) && <a href={`https://pmc.ncbi.nlm.nih.gov/articles/${item.pmcid}/`} target="_blank" rel="noreferrer" aria-label={`Full text: ${item.title}`}>Full text</a>}
                    <a href={`#${encodeURIComponent(publicationAnchor(item))}`} aria-label={`Link to citation: ${item.title}`}>Link to citation</a>
                  </div>
                  {item.doi && <span class="publication-row__print-doi">https://doi.org/{item.doi}</span>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
