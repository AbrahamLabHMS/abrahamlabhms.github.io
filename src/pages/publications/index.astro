---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publications } from "../../data/publications";
import { formatDateLabel, publicationAnchor, publicationSections } from "../../lib/content";
import { siteData } from "../../data/site";
import { jonathanProfile } from "../../data/jonathan";
import PublicationFigure from "../../components/PublicationFigure.astro";
import publicationFigures from "../../data/publication-figures.json";

const sections = publicationSections(publications);
const figuresByDoi = new Map(publicationFigures.map(figure => [figure.doi, figure]));
const pdbUrl = (id: string) => `https://www.rcsb.org/structure/${id}`;
const emdbUrl = (id: string) => `https://www.ebi.ac.uk/emdb/${id}`;
const isPrimaryDestination = (link: string, primary: string) => {
  const left = new URL(link);
  const right = new URL(primary);
  return left.origin === right.origin && left.pathname.replace(/\/$/, "") === right.pathname.replace(/\/$/, "");
};
---

<BaseLayout
  title="Publications"
  description="Publication record for the Abraham Lab, including papers, preprints, structures, and public research resources."
  pageClass="page-publications"
  socialImage={siteData.shareImages.science.image}
  socialImageAlt={siteData.shareImages.science.alt}
  socialImageWidth={siteData.shareImages.science.width}
  socialImageHeight={siteData.shareImages.science.height}
  modifiedAt={siteData.publicationRecord.checkedAt}
>
  <section class="page-intro page-intro--publications">
    <div class="shell page-intro__grid">
      <div class="page-intro__copy reveal">
        <h1>Publications</h1>
      </div>
      <div class="page-intro__actions reveal">
        <a class="publication-pubmed-link" href={jonathanProfile.pubmedUrl} target="_blank" rel="noreferrer">
          Jonathan Abraham on PubMed <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <nav class="publication-index" aria-label="Publication sections">
    <div class="shell publication-index__inner">
      <ol>
        {sections.map((section) => (
          <li><a href={`#${section.id}`}>{section.label}</a></li>
        ))}
      </ol>
    </div>
  </nav>

  {sections.map((section) => (
  <section class="publication-record" id={section.id} aria-labelledby={`${section.id}-title`}>
    <div class="shell">
      <header class="publication-record__heading">
        <div>
          <h2 id={`${section.id}-title`}>{section.label}</h2>
          {section.note && <p>{section.note}</p>}
        </div>
        {section.years.length > 1 && (
          <nav class="publication-years" aria-label={`${section.label} by year`}>
            <ol>
              {section.years.map((yearGroup) => (
                <li><a href={`#${yearGroup.id}`}>{yearGroup.year}</a></li>
              ))}
            </ol>
          </nav>
        )}
      </header>
      <div class="publication-record__list" id={`${section.id}-list`}>
      {section.years.map((yearGroup) => (
        <section class="publication-year" id={yearGroup.legacyId} aria-labelledby={yearGroup.id}>
          <h3 class="publication-year__label" id={yearGroup.id}>{yearGroup.year}</h3>
          <ol>
            {yearGroup.entries.map((item) => (
              <li class:list={["publication-row reveal", figuresByDoi.has(item.doi ?? "") && "publication-row--with-figure"]} id={publicationAnchor(item)} data-article-type={item.articleType}>
                <div class="publication-row__record">
                  <div class="publication-row__body">
                    <h4 class="publication-row__title"><a href={item.link} target="_blank" rel="noreferrer">{item.title}</a></h4>
                    <p class="publication-row__citation">{item.authors}</p>
                  </div>
                    <div class="publication-row__meta">
                      <time datetime={item.publishedAt ?? String(item.year)}>{item.publishedAt ? formatDateLabel(item.publishedAt) : item.year}</time>
                      {item.articleType && item.articleType !== "Research article" && <span class:list={["publication-row__type", item.articleType === "Preprint" && "publication-row__type--preprint"]}>{item.articleType}</span>}
                      {item.openAccess && <span class="publication-row__access">Open access</span>}
                    </div>
                  <div class="publication-row__links">
                    {item.pmid && !isPrimaryDestination(`https://pubmed.ncbi.nlm.nih.gov/${item.pmid}/`, item.link) && <a href={`https://pubmed.ncbi.nlm.nih.gov/${item.pmid}/`} target="_blank" rel="noreferrer" aria-label={`PubMed: ${item.title}`}>PubMed <span aria-hidden="true">↗</span></a>}
                    {item.pmcid && !isPrimaryDestination(`https://pmc.ncbi.nlm.nih.gov/articles/${item.pmcid}/`, item.link) && <a href={`https://pmc.ncbi.nlm.nih.gov/articles/${item.pmcid}/`} target="_blank" rel="noreferrer" aria-label={`Full text: ${item.title}`}>Full text <span aria-hidden="true">↗</span></a>}
                    <a class="publication-row__permalink" href={`#${encodeURIComponent(publicationAnchor(item))}`} aria-label={`Link to citation: ${item.title}`}>Link to citation</a>
                  </div>
                  {(item.structures?.pdb?.length || item.structures?.emdb?.length || item.resourceLinks?.length || item.coverageLinks?.length) && (
                    <div class="publication-row__outputs" aria-label={`Research outputs for ${item.title}`}>
                      {item.structures?.pdb?.length && (
                        <div class="publication-output">
                          <span>PDB</span>
                          <ul>
                            {item.structures.pdb.map((id) => (
                              <li><a href={pdbUrl(id)} target="_blank" rel="noreferrer">{id}</a></li>
                            ))}
                          </ul>
                        </div>
                      )}
                      {item.structures?.emdb?.length && (
                        <div class="publication-output">
                          <span>EMDB</span>
                          <ul>
                            {item.structures.emdb.map((id) => (
                              <li><a href={emdbUrl(id)} target="_blank" rel="noreferrer">{id}</a></li>
                            ))}
                          </ul>
                        </div>
                      )}
                      {item.resourceLinks?.length && (
                        <div class="publication-output">
                          <span>Resources</span>
                          <ul>
                            {item.resourceLinks.map((resource) => (
                              <li><a href={resource.href} target="_blank" rel="noreferrer">{resource.label}</a></li>
                            ))}
                          </ul>
                        </div>
                      )}
                      {item.coverageLinks?.length && (
                        <div class="publication-output">
                          <span>Coverage</span>
                          <ul>
                            {item.coverageLinks.map((href) => (
                              <li><a href={href} target="_blank" rel="noreferrer">Harvard Medical School</a></li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </div>
                  )}
                  {item.doi && <span class="publication-row__print-doi">https://doi.org/{item.doi}</span>}
                </div>
                {figuresByDoi.has(item.doi ?? "") && <PublicationFigure figure={figuresByDoi.get(item.doi ?? "")!} />}
              </li>
            ))}
          </ol>
        </section>
      ))}
      </div>
    </div>
  </section>
  ))}
</BaseLayout>
