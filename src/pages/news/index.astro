---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { newsItems } from "../../data/news";
import { formatDateLabel } from "../../lib/content";
import { siteData } from "../../data/site";

const renderedNews = newsItems.filter((item) => item.category === "Institutional coverage");
---

<BaseLayout
  title="HMS coverage"
  description="Harvard Medical School films and stories about the Abraham Lab and its work."
  socialImage={siteData.shareImages.film.image}
  socialImageAlt={siteData.shareImages.film.alt}
  socialImageWidth={siteData.shareImages.film.width}
  socialImageHeight={siteData.shareImages.film.height}
>
  <section class="page-intro page-intro--quiet">
    <div class="shell page-intro__grid">
      <div class="page-intro__copy reveal">
        <p class="overline">HMS coverage</p>
        <h1>Films and stories</h1>
      </div>
      <a class="text-link page-intro__link" href={siteData.social.x} target="_blank" rel="noreferrer">Abraham Lab on X <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="coverage-list">
    <div class="shell">
      {renderedNews.map((item) => (
        <article class="coverage-row reveal">
          <time datetime={item.date}>{formatDateLabel(item.date)}</time>
          <div>
            <p class="overline">{item.source}</p>
            <h2><a href={item.link} target="_blank" rel="noreferrer">{item.title}</a></h2>
            <p>{item.summary}</p>
          </div>
          <a class="coverage-row__action" href={item.link} target="_blank" rel="noreferrer" aria-label={`${item.linkLabel ?? "Open"}: ${item.title}`}>↗</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
