---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MembershipDates from "../../components/MembershipDates.astro";
import { peopleData } from "../../data/people";
import { siteData } from "../../data/site";
import { groupPeople, withBase } from "../../lib/content";

const groupedPeople = groupPeople(peopleData.currentMembers);
const anchorFor = (label: string) =>
  label.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const directoryIndex = [
  ...groupedPeople.map((group) => ({ label: group.label, id: anchorFor(group.label) })),
  ...(peopleData.seasonalMembers.length
    ? [{ label: "Summer researchers", id: "summer-researchers" }]
    : []),
  { label: "Alumni", id: "alumni" }
];
---

<BaseLayout
  title="Team"
  description="Current members and alumni of the Abraham Lab at Harvard Medical School."
  socialImage={siteData.shareImages.science.image}
  socialImageAlt={siteData.shareImages.science.alt}
  socialImageWidth={siteData.shareImages.science.width}
  socialImageHeight={siteData.shareImages.science.height}
>
  <section class="page-intro page-intro--team">
    <div class="shell page-intro__grid">
      <div class="page-intro__copy reveal">
        <p class="overline">Abraham Lab</p>
        <h1>Team</h1>
        <p>Faculty, fellows, students, and staff at Harvard Medical School.</p>
      </div>
    </div>
  </section>

  <nav class="directory-nav" aria-label="Team directory sections">
    <div class="shell directory-nav__inner">
      {directoryIndex.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
    </div>
  </nav>

  <div class="shell team-directory">
    {groupedPeople.map((group) => (
      <section class="team-group" id={anchorFor(group.label)}>
        <header class="team-group__header reveal"><h2>{group.label}</h2></header>
        <div class="team-list" role="list">
          {group.entries.map((person) => (
            <article class="team-row reveal" role="listitem">
              <div class="team-row__identity">
                <h3>{person.name}</h3>
                {group.label === "Leadership" && (
                  <a href={withBase("/jonathan-abraham/")}>View profile <span aria-hidden="true">→</span></a>
                )}
              </div>
              <div class="team-row__appointment">
                <p class="team-row__role">{person.title}</p>
                {(person.programTags?.length || person.fellowships?.length) && <div class="team-row__details">
                  {person.programTags?.map((tag) => (
                    <a href={siteData.trainingPrograms[tag]} target="_blank" rel="noreferrer">{tag} <span aria-hidden="true">↗</span></a>
                  ))}
                  {person.fellowships?.map((fellowship) => <span>{fellowship}</span>)}
                </div>}
              </div>
              <div class="team-row__dates"><MembershipDates start={person.labStart} end={person.labEnd} /></div>
            </article>
          ))}
        </div>
      </section>
    ))}

    {peopleData.seasonalMembers.length > 0 && (
      <section class="team-group team-group--seasonal" id="summer-researchers">
        <header class="team-group__header reveal"><h2>Summer researchers</h2></header>
        <div class="team-list" role="list">
          {peopleData.seasonalMembers.map((person) => (
            <article class="team-row reveal" role="listitem">
              <div class="team-row__identity"><h3>{person.name}</h3></div>
              <div class="team-row__appointment">
                <p class="team-row__role">{person.title}</p>
                {person.program && <div class="team-row__details"><span>{person.program}</span></div>}
              </div>
              <div class="team-row__dates"><MembershipDates start={person.labStart} end={person.labEnd} summers={person.summers} /></div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="alumni-register" id="alumni">
      <header class="team-group__header reveal"><h2>Alumni</h2></header>
      <div class="alumni-register__grid">
        {peopleData.alumni.map((group) => (
          <section class="alumni-group reveal">
            <h3>{group.label}</h3>
            <ul>
              {group.entries.map((entry) => (
                <li>
                  <span>{entry.name}</span>
                  <span class="alumni-group__details">
                    <MembershipDates start={entry.labStart} end={entry.labEnd} summers={entry.summers} />
                    {entry.destination && <small>{entry.destinationSource ? (
                      <a href={entry.destinationSource} target="_blank" rel="noreferrer">{entry.destination}</a>
                    ) : entry.destination}</small>}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
