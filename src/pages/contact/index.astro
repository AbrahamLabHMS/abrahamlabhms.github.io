---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MapWidget from "../../components/MapWidget.astro";
import { siteData } from "../../data/site";
---

<BaseLayout
  title="Contact"
  description="Contact and location information for the Abraham Lab at Harvard Medical School."
>
  <section class="page-intro page-intro--utility">
    <div class="shell page-intro__grid">
      <div class="page-intro__copy reveal">
        <p class="overline">Abraham Lab</p>
        <h1>Contact</h1>
      </div>
    </div>
  </section>

  <section class="contact-page">
    <div class="shell contact-page__grid">
      <div class="contact-page__details">
        <section class="contact-block reveal">
          <p class="overline">Scientific correspondence</p>
          <div class="contact-block__content">
            <h2>Jonathan Abraham</h2>
            <p>Research, speaking, and postdoctoral inquiries</p>
            <a href={`mailto:${siteData.contact.email}`}>{siteData.contact.email}</a>
          </div>
        </section>
        <section class="contact-block reveal">
          <p class="overline">Administration &amp; Operations</p>
          <div class="contact-block__content">
            <h2>James Spencer</h2>
            <p>Lab Manager</p>
            <a href={`mailto:${siteData.contact.managerEmail}`}>{siteData.contact.managerEmail}</a>
          </div>
        </section>
        <section class="contact-block reveal">
          <p class="overline">Location</p>
          <div class="contact-block__content">
            <address>{siteData.contact.addressLines.map((line) => <span>{line}</span>)}</address>
            <a href={siteData.contact.mapUrl} target="_blank" rel="noreferrer">Directions in Google Maps <span aria-hidden="true">↗</span></a>
          </div>
        </section>
        <section class="contact-block reveal">
          <p class="overline">Graduate training</p>
          <div class="contact-block__content">
            <h2>Harvard programs</h2>
            <ul class="contact-programs">
              {siteData.graduatePrograms.map(({label, href}) => (
                <li><a href={href} target="_blank" rel="noreferrer">{label} <span aria-hidden="true">↗</span></a></li>
              ))}
            </ul>
          </div>
        </section>
      </div>
      <MapWidget eyebrow="Campus map" />
    </div>

  </section>
</BaseLayout>
