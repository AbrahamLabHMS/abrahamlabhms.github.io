---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { jonathanProfile } from "../../data/jonathan";
import { siteData } from "../../data/site";
import { withBase } from "../../lib/content";

const personData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: jonathanProfile.name,
  jobTitle: "Professor of Microbiology",
  affiliation: [
    { "@type": "Organization", name: "Harvard Medical School" },
    { "@type": "Organization", name: "Howard Hughes Medical Institute" },
    { "@type": "Organization", name: "Brigham and Women's Hospital" }
  ],
  url: new URL(withBase("/jonathan-abraham/"), siteData.url).toString(),
  sameAs: jonathanProfile.profileLinks
    .filter((item) => /hhmi\.org\/scientists\/|massgeneralbrigham\.org\/en\/doctors\/|orcid\.org\//.test(item.href))
    .map((item) => item.href)
};
---

<BaseLayout
  title="Jonathan Abraham"
  description="Jonathan Abraham is Professor of Microbiology at Harvard Medical School, an HHMI Investigator, and an Associate Physician at Brigham and Women's Hospital."
  socialImage={siteData.shareImages.film.image}
  socialImageAlt={siteData.shareImages.film.alt}
  socialImageWidth={siteData.shareImages.film.width}
  socialImageHeight={siteData.shareImages.film.height}
  ogType="profile"
  structuredData={personData}
>
  <section class="profile-dossier">
    <div class="shell profile-dossier__grid">
      <header class="profile-dossier__identity reveal">
        <p class="overline">Principal investigator</p>
        <h1>{jonathanProfile.name}</h1>
        <p>{jonathanProfile.title}</p>
        <p>{jonathanProfile.secondaryTitle}</p>
        <p>{jonathanProfile.clinicalTitle}</p>
      </header>
      <div class="profile-dossier__summary reveal">
        <p class="profile-dossier__overview">{jonathanProfile.overview}</p>
        <div class="profile-dossier__links">
          {jonathanProfile.profileLinks.map((item) => (
            <a class="text-link" href={item.href} target="_blank" rel="noreferrer">{item.label} <span aria-hidden="true">↗</span></a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section profile-story">
    <div class="shell profile-story__grid">
      <article class="profile-story__body reveal">
        <h2>Biography</h2>
        {jonathanProfile.biography.map((paragraph) => <p>{paragraph}</p>)}
        <a class="button button--primary" href={jonathanProfile.pubmedUrl} target="_blank" rel="noreferrer">View publications</a>
      </article>

      <aside class="profile-story__rail">
        <section class="profile-list reveal">
          <h2>Distinctions</h2>
          <ul>{jonathanProfile.distinctions.map((item) => <li>{item}</li>)}</ul>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>
