---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteData } from "../data/site";
import { withBase } from "../lib/content";
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/inter-tight/wght.css";
import "@fontsource-variable/newsreader/wght.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  canonicalPath?: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  ogType?: "website" | "profile";
  modifiedAt?: string;
  noIndex?: boolean;
  redirectTo?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  pageClass,
  canonicalPath,
  socialImage: socialImagePath,
  socialImageAlt = siteData.shareImages.campus.alt,
  socialImageWidth = siteData.shareImages.campus.width,
  socialImageHeight = siteData.shareImages.campus.height,
  ogType = "website",
  modifiedAt,
  noIndex = false,
  redirectTo,
  structuredData
} = Astro.props;
const pageTitle = title ? `${title} | ${siteData.fullName}` : siteData.fullName;
const metaDescription = description ?? siteData.description;
const canonicalTarget = canonicalPath ? withBase(canonicalPath) : Astro.url.pathname;
const canonical = new URL(canonicalTarget, siteData.url).toString();
const socialImage = new URL(withBase(socialImagePath ?? siteData.shareImages.campus.image), siteData.url).toString();
const socialImageType = socialImage.endsWith(".webp") ? "image/webp" : socialImage.endsWith(".png") ? "image/png" : "image/jpeg";
const themeDefaultMode = siteData.theme.defaultMode;
const themeColorLight = "#f5f7f6";
const themeColorDark = "#242a2b";
const themeColorHero = "#101716";
const isHomePage = pageClass === "page-home";
const organizationId = `${new URL(withBase("/"), siteData.url).toString()}#organization`;
const websiteId = `${new URL(withBase("/"), siteData.url).toString()}#website`;
const organizationData = {
  "@type": "Organization",
  "@id": organizationId,
  name: siteData.fullName,
  url: new URL(withBase("/"), siteData.url).toString(),
  description: siteData.description,
  parentOrganization: {
    "@type": "Organization",
    name: "Department of Microbiology, Blavatnik Institute, Harvard Medical School",
    url: "https://micro.hms.harvard.edu/",
    parentOrganization: {
      "@type": "CollegeOrUniversity",
      name: "Harvard Medical School",
      url: "https://hms.harvard.edu/"
    }
  },
  sameAs: [siteData.social.x]
};
const websiteData = {
  "@type": "WebSite",
  "@id": websiteId,
  name: siteData.name,
  alternateName: siteData.fullName,
  url: new URL(withBase("/"), siteData.url).toString(),
  publisher: { "@id": organizationId }
};
const webPageData = {
  "@type": "WebPage",
  "@id": canonical,
  url: canonical,
  name: pageTitle,
  description: metaDescription,
  isPartOf: { "@id": websiteId },
  about: { "@id": organizationId },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: socialImage,
    width: socialImageWidth,
    height: socialImageHeight,
    caption: socialImageAlt
  },
  ...(modifiedAt ? { dateModified: modifiedAt } : {})
};
const breadcrumbData = title && !noIndex ? {
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL(withBase("/"), siteData.url).toString()
    },
    {
      "@type": "ListItem",
      position: 2,
      name: title,
      item: canonical
    }
  ]
} : null;
const extraStructuredData = (structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [])
  .map((entry) => Object.fromEntries(Object.entries(entry).filter(([key]) => key !== "@context")));
const graph = [organizationData, websiteData, webPageData, ...(breadcrumbData ? [breadcrumbData] : []), ...extraStructuredData];
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={isHomePage ? themeColorHero : themeColorLight} />
    <script is:inline define:vars={{ themeDefaultMode, themeColorLight, themeColorDark, themeColorHero, isHomePage }}>
      (() => {
        const root = document.documentElement;
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = themeDefaultMode === "system" ? (prefersDark ? "dark" : "light") : "light";
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        if (themeMeta) {
          themeMeta.setAttribute("content", isHomePage ? themeColorHero : (theme === "dark" ? themeColorDark : themeColorLight));
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={siteData.fullName} />
    <meta name="robots" content={noIndex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
    {redirectTo && <meta http-equiv="refresh" content={`0; url=${withBase(redirectTo)}`} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteData.fullName} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={String(socialImageWidth)} />
    <meta property="og:image:height" content={String(socialImageHeight)} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@abrahamlabhms" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/assets/images/brands/abraham-lab-icon-32.png")} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase("/assets/images/brands/abraham-lab-mark.svg")} type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href={withBase("/assets/images/brands/abraham-lab-touch-180.png")} sizes="180x180" />
  </head>
  <body class:list={["site-body", pageClass]}>
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script is:inline define:vars={{ themeDefaultMode, themeColorLight, themeColorDark, themeColorHero }}>
      const navToggle = document.querySelector(".nav-toggle");
      const nav = document.querySelector(".site-nav");
      const root = document.documentElement;
      const body = document.body;
      const hero = document.querySelector(".page-home .home-hero");
      const header = document.querySelector(".site-header");
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
      const resolveTheme = () => {
        return prefersDark.matches ? "dark" : "light";
      };
      const syncThemeColor = () => {
        if (!themeMeta) return;
        const theme = root.dataset.theme === "dark" ? "dark" : "light";
        const heroActive = body.classList.contains("page-home") && !body.classList.contains("home-hero-past");
        themeMeta.setAttribute("content", heroActive ? themeColorHero : (theme === "dark" ? themeColorDark : themeColorLight));
      };
      const applyTheme = (theme) => {
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        syncThemeColor();
      };
      const syncHeroHeader = () => {
        if (!(hero instanceof HTMLElement) || !(header instanceof HTMLElement)) {
          body.classList.remove("home-hero-past");
          syncThemeColor();
          return;
        }
        const threshold = Math.max(hero.offsetHeight - header.offsetHeight - 24, 0);
        body.classList.toggle("home-hero-past", window.scrollY > threshold);
        syncThemeColor();
      };

      applyTheme(resolveTheme());
      syncHeroHeader();

      const syncSystemTheme = () => {
        if (themeDefaultMode === "system") {
          applyTheme(prefersDark.matches ? "dark" : "light");
        }
      };

      if ("addEventListener" in prefersDark) {
        prefersDark.addEventListener("change", syncSystemTheme);
      } else if ("addListener" in prefersDark) {
        prefersDark.addListener(syncSystemTheme);
      }

      if (navToggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
        const mobileNav = window.matchMedia("(max-width: 1040px)");
        let lastNavFocus = null;
        document.addEventListener("focusin", (event) => {
          const target = event.target;
          lastNavFocus = target instanceof HTMLElement && (nav.contains(target) || target === navToggle) ? target : null;
        });
        document.addEventListener("focusout", (event) => {
          if (event.target === lastNavFocus && lastNavFocus?.getClientRects().length) {
            lastNavFocus = null;
          }
        });
        document.addEventListener("pointerdown", (event) => {
          if (event.target instanceof Node && !nav.contains(event.target) && !navToggle.contains(event.target)) {
            lastNavFocus = null;
          }
        });
        const closeNav = (restoreFocus = false) => {
          nav.classList.remove("is-open");
          navToggle.setAttribute("aria-expanded", "false");
          if (restoreFocus && mobileNav.matches) navToggle.focus({ preventScroll: true });
        };

        navToggle.addEventListener("click", () => {
          const isOpen = nav.classList.toggle("is-open");
          navToggle.setAttribute("aria-expanded", String(isOpen));
        });

        nav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => closeNav());
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && mobileNav.matches && nav.classList.contains("is-open")) {
            const focusInMenu = nav.contains(document.activeElement) || document.activeElement === navToggle;
            if (focusInMenu) event.preventDefault();
            closeNav(focusInMenu);
          }
        });

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Node)) return;
          if (!nav.contains(target) && !navToggle.contains(target)) {
            closeNav(nav.contains(document.activeElement));
          }
        });

        const syncNavLayout = () => {
          // Chromium may blur a CSS-hidden control before the media-query event.
          const active = document.activeElement === document.body ? lastNavFocus : document.activeElement;
          const focusInNav = nav.contains(active);
          const focusOnToggle = active === navToggle;
          closeNav(mobileNav.matches && focusInNav);
          if (!mobileNav.matches && focusOnToggle) {
            nav.querySelector("a")?.focus({ preventScroll: true });
          }
        };

        if ("addEventListener" in mobileNav) {
          mobileNav.addEventListener("change", syncNavLayout);
        } else if ("addListener" in mobileNav) {
          mobileNav.addListener(syncNavLayout);
        }
      }

      root.classList.add("js");

      if (body.classList.contains("page-home")) {
        window.addEventListener("scroll", syncHeroHeader, { passive: true });
        window.addEventListener("resize", syncHeroHeader);
      }

      const revealNodes = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && revealNodes.length && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                // Content stays readable even if motion never initializes.
                if (entry.target.getBoundingClientRect().top > 0 && !entry.target.contains(document.activeElement)) {
                  entry.target.classList.add("reveal-enter");
                }
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0, rootMargin: "0px 0px -4% 0px" }
        );

        revealNodes.forEach((node) => observer.observe(node));
      }
    </script>
  </body>
</html>
