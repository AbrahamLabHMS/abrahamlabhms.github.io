---
import type { LinkedInProfile } from "../data/types";
import { publicEmailHref, publicLinkedInUrl } from "../lib/team-links";

interface Props {
  name: string;
  linkedin?: LinkedInProfile;
  publicEmail?: string;
}

const { name, linkedin, publicEmail } = Astro.props;
const profileUrl = publicLinkedInUrl(linkedin);
const emailHref = publicEmailHref(publicEmail);
---

<div class="team-row__name">
  <h3>{name}</h3>
  {(profileUrl || emailHref) && <div class="team-row__links">
    {profileUrl && (
      <a
        class="team-profile-link team-linkedin"
        href={profileUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${name} on LinkedIn (opens in a new tab)`}
        title="LinkedIn (opens in a new tab)"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
        </svg>
      </a>
    )}
    {emailHref && (
      <a
        class="team-profile-link team-email"
        href={emailHref}
        aria-label={`Email ${name}`}
        title={`Email ${name}: ${publicEmail}`}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <rect x="3" y="5" width="18" height="14" rx="1" />
          <path d="m3 6 9 7 9-7" />
        </svg>
      </a>
    )}
  </div>}
</div>
