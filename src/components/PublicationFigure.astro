---
import { withBase } from "../lib/content";

interface Props {
  figure: {
    key: string;
    publicationTitle: string;
    figureNumber: string;
    caption: string;
    alt: string;
    attribution: string;
    sourceUrl: string;
    license: string;
    licenseUrl: string;
    image: string;
    width: number;
    height: number;
    variants: { src: string; width: number; height: number }[];
  };
}

const { figure } = Astro.props;
const srcset = figure.variants.map(variant => `${withBase(variant.src)} ${variant.width}w`).join(", ");
const viewerId = `figure-viewer-${figure.key}`;
const captionId = `figure-caption-${figure.key}`;
---

<figure class="publication-figure" data-figure-key={figure.key} aria-labelledby={captionId}>
  <a
    class="publication-figure__thumbnail"
    href={withBase(figure.image)}
    data-figure-viewer={viewerId}
    target="_blank"
    rel="noreferrer"
    aria-label={`Enlarge ${figure.figureNumber.toLowerCase()} for ${figure.publicationTitle}`}
  >
    <span class="publication-figure__matte">
    <img
      src={withBase(figure.image)}
      srcset={srcset}
      sizes="(max-width: 700px) calc(100vw - 64px), (max-width: 1040px) 256px, 336px"
      width={figure.width}
      height={figure.height}
      alt={figure.alt}
      loading="lazy"
      decoding="async"
    />
    </span>
    <span class="publication-figure__label"><span>{figure.figureNumber}</span><span aria-hidden="true">&#x2922;</span></span>
  </a>
  <figcaption>
    <p class="publication-figure__caption" id={captionId}>
      {figure.caption}
    </p>
    <details class="publication-figure__credit">
      <summary>Image credit</summary>
      <p>{figure.attribution}</p>
      <div class="publication-figure__sources">
        <a href={figure.sourceUrl} target="_blank" rel="noreferrer">Source figure <span aria-hidden="true">↗</span></a>
        <a href={figure.licenseUrl} target="_blank" rel="noreferrer">{figure.license}</a>
      </div>
    </details>
  </figcaption>
</figure>

<dialog class="figure-viewer" id={viewerId} aria-labelledby={`${viewerId}-title`}>
  <div class="figure-viewer__header">
    <p id={`${viewerId}-title`}>{figure.figureNumber} <span aria-hidden="true">/</span> {figure.publicationTitle}</p>
    <form method="dialog"><button type="submit" autofocus>Close <span aria-hidden="true">×</span></button></form>
  </div>
  <div class="figure-viewer__body">
    <div class="figure-viewer__matte">
      <img
        src={withBase(figure.image)}
        width={figure.width}
        height={figure.height}
        style={`max-width: min(100%, ${figure.width}px)`}
        alt={figure.alt}
        loading="lazy"
        decoding="async"
      />
    </div>
    <p class="figure-viewer__caption"><strong>{figure.figureNumber}.</strong> {figure.caption}</p>
    <p class="figure-viewer__credit">{figure.attribution}</p>
    <div class="publication-figure__sources">
      <a href={withBase(figure.image)} target="_blank" rel="noreferrer">Open full-size image <span aria-hidden="true">↗</span></a>
      <a href={figure.sourceUrl} target="_blank" rel="noreferrer">Source figure <span aria-hidden="true">↗</span></a>
      <a href={figure.licenseUrl} target="_blank" rel="noreferrer">{figure.license}</a>
    </div>
  </div>
</dialog>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-figure-viewer]")) {
    const viewer = document.getElementById(link.dataset.figureViewer ?? "");
    if (!(viewer instanceof HTMLDialogElement) || typeof viewer.showModal !== "function") continue;
    link.setAttribute("aria-haspopup", "dialog");
    link.addEventListener("click", (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      // Native dialog focus restoration also needs a focused link after pointer activation.
      link.focus({ preventScroll: true });
      viewer.showModal();
    });
    viewer.addEventListener("keydown", (event) => {
      if (event.key !== "Tab" || event.ctrlKey || event.metaKey) return;
      const controls = [...viewer.querySelectorAll<HTMLElement>("button, a[href]")];
      const index = controls.indexOf(document.activeElement as HTMLElement);
      const next = (index + (event.shiftKey ? -1 : 1) + controls.length) % controls.length;
      event.preventDefault();
      controls[next].focus();
    });
  }
</script>

<style>
  .publication-figure {
    min-width: 0;
    width: 100%;
    margin: 0;
  }

  .publication-figure__thumbnail {
    display: block;
    background: #fff;
    border: 1px solid var(--line);
    color-scheme: light;
    text-decoration: none;
    cursor: zoom-in;
  }

  .publication-figure__matte {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
  }

  .publication-figure__thumbnail img {
    position: absolute;
    inset: 0.75rem;
    width: calc(100% - 1.5rem);
    height: calc(100% - 1.5rem);
    object-fit: contain;
  }

  .publication-figure__label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.75rem;
    color: #182021;
    border-top: 1px solid #e3e8e8;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .publication-figure__label > span:last-child {
    font-size: 1rem;
    line-height: 1;
  }

  .publication-figure__thumbnail:hover {
    border-color: var(--accent);
  }

  .publication-figure__thumbnail:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  figcaption {
    padding-top: 0.7rem;
  }

  .publication-figure__caption {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .publication-figure__credit {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--ink-quiet);
  }

  .publication-figure__credit summary {
    width: fit-content;
    min-height: 2.75rem;
    align-content: center;
    cursor: pointer;
  }

  .publication-figure__credit p {
    margin-bottom: 0.2rem;
  }

  .publication-figure__sources {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.2rem;
  }

  .publication-figure__sources a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.75rem;
    color: var(--accent-hover);
    font-size: 0.8125rem;
  }

  .figure-viewer {
    width: min(76rem, calc(100% - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 0.25rem;
    color: var(--ink);
    background: var(--surface);
  }

  .figure-viewer::backdrop {
    background: rgb(12 18 18 / 72%);
  }

  :global(html:has(.figure-viewer[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  .figure-viewer__header {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .figure-viewer__header p {
    min-width: 0;
    max-width: 70ch;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .figure-viewer__header p span {
    padding-inline: 0.35rem;
    color: var(--ink-quiet);
  }

  .figure-viewer__header form {
    flex: 0 0 auto;
  }

  .figure-viewer__header button {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    font: 500 0.875rem/1.3 var(--font-sans);
    cursor: pointer;
  }

  .figure-viewer__body {
    padding: 1.25rem;
  }

  .figure-viewer__matte {
    display: grid;
    place-items: center;
    padding: 1rem;
    background: #fff;
    color-scheme: light;
  }

  .figure-viewer__matte img {
    width: auto;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
  }

  .figure-viewer__caption {
    margin-top: 1.2rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .figure-viewer__credit {
    max-width: 95ch;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--ink-quiet);
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .publication-figure {
      max-width: 30rem;
    }

    .figure-viewer__header {
      align-items: flex-start;
      padding: 0.75rem;
    }

    .figure-viewer__body {
      padding: 0.75rem;
    }

    .figure-viewer__matte {
      padding: 0.5rem;
    }
  }
</style>
