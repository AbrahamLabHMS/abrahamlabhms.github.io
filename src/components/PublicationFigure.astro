---
import { withBase } from "../lib/content";

interface Props {
  figure: {
    key: string;
    publicationTitle: string;
    figureNumber: string;
    caption: string;
    alt: string;
    attribution: string;
    sourceUrl: string;
    license: string;
    licenseUrl: string;
    image: string;
    width: number;
    height: number;
    variants: { src: string; width: number; height: number }[];
  };
}

const { figure } = Astro.props;
const srcset = figure.variants.map(variant => `${withBase(variant.src)} ${variant.width}w`).join(", ");
const viewerId = `figure-viewer-${figure.key}`;
const captionId = `figure-caption-${figure.key}`;
const previewRatio = Math.max(1, Math.min(1.6, figure.width / figure.height));
---

<figure class="publication-figure" data-figure-key={figure.key} aria-labelledby={captionId} style={{ "--figure-preview-ratio": previewRatio, "--figure-native-width": `${figure.width}px` }}>
  <a
    class="publication-figure__thumbnail"
    href={withBase(figure.image)}
    data-figure-viewer={viewerId}
    target="_blank"
    rel="noreferrer"
    aria-label={`Enlarge ${figure.figureNumber.toLowerCase()} for ${figure.publicationTitle}`}
  >
    <span class="publication-figure__matte">
    <img
      src={withBase(figure.image)}
      srcset={srcset}
      sizes="(max-width: 840px) min(32rem, calc(100vw - 80px)), (max-width: 1180px) 264px, 384px"
      width={figure.width}
      height={figure.height}
      alt={figure.alt}
      loading="lazy"
      decoding="async"
    />
    </span>
    <span class="publication-figure__label"><span>{figure.figureNumber}</span><span class="publication-figure__enlarge">Enlarge <span aria-hidden="true">↗</span></span></span>
  </a>
  <figcaption>
    <p class="publication-figure__caption" id={captionId}>
      {figure.caption}
    </p>
    <details class="publication-figure__credit">
      <summary>Image credit</summary>
      <p>{figure.attribution}</p>
      <div class="publication-figure__sources">
        <a href={figure.sourceUrl} target="_blank" rel="noreferrer">Source figure <span aria-hidden="true">↗</span></a>
        <a href={figure.licenseUrl} target="_blank" rel="noreferrer">{figure.license}</a>
      </div>
    </details>
  </figcaption>
</figure>

<dialog class="figure-viewer" id={viewerId} aria-labelledby={`${viewerId}-title`}>
  <div class="figure-viewer__header">
    <p id={`${viewerId}-title`}><span class="figure-viewer__number">{figure.figureNumber}</span>{figure.publicationTitle}</p>
    <form method="dialog">
      <button class="figure-viewer__close" type="submit" aria-label="Close figure" autofocus>
        <span>Close</span>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" /></svg>
      </button>
    </form>
  </div>
  <div class="figure-viewer__body">
    <div class="figure-viewer__matte">
      <img
        src={withBase(figure.image)}
        width={figure.width}
        height={figure.height}
        style={`max-width: min(100%, ${figure.width}px)`}
        alt={figure.alt}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="figure-viewer__info">
      <p class="figure-viewer__caption">{figure.caption}</p>
      <p class="figure-viewer__credit">{figure.attribution}</p>
      <div class="publication-figure__sources">
        <a href={withBase(figure.image)} target="_blank" rel="noreferrer">Open full-size image <span aria-hidden="true">↗</span></a>
        <a href={figure.sourceUrl} target="_blank" rel="noreferrer">Source figure <span aria-hidden="true">↗</span></a>
        <a href={figure.licenseUrl} target="_blank" rel="noreferrer">{figure.license}</a>
      </div>
    </div>
  </div>
</dialog>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-figure-viewer]")) {
    const viewer = document.getElementById(link.dataset.figureViewer ?? "");
    if (!(viewer instanceof HTMLDialogElement) || typeof viewer.showModal !== "function") continue;
    link.setAttribute("aria-haspopup", "dialog");
    link.addEventListener("click", (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      // Native dialog focus restoration also needs a focused link after pointer activation.
      link.focus({ preventScroll: true });
      viewer.showModal();
      viewer.scrollTop = 0;
    });
    const isBackdrop = (event: MouseEvent) => {
      const bounds = viewer.getBoundingClientRect();
      return event.target === viewer && (
        event.clientX < bounds.left || event.clientX > bounds.right ||
        event.clientY < bounds.top || event.clientY > bounds.bottom
      );
    };
    let backdropPointer: number | null = null;
    let backdropClick = false;
    viewer.addEventListener("pointerdown", (event) => {
      backdropClick = false;
      backdropPointer = event.isPrimary && event.button === 0 && isBackdrop(event) ? event.pointerId : null;
    });
    viewer.addEventListener("pointerup", (event) => {
      // Both ends must be on the backdrop; dragging out of a figure must not dismiss it.
      backdropClick = backdropPointer === event.pointerId && isBackdrop(event);
      backdropPointer = null;
    });
    viewer.addEventListener("click", (event) => {
      const dismiss = backdropClick && isBackdrop(event);
      backdropClick = false;
      if (dismiss) viewer.close();
    });
    const resetBackdrop = () => { backdropPointer = null; backdropClick = false; };
    viewer.addEventListener("pointercancel", resetBackdrop);
    viewer.addEventListener("close", resetBackdrop);
    viewer.addEventListener("keydown", (event) => {
      if (event.key !== "Tab" || event.ctrlKey || event.metaKey) return;
      const controls = [...viewer.querySelectorAll<HTMLElement>("button, a[href]")];
      const index = controls.indexOf(document.activeElement as HTMLElement);
      const next = (index + (event.shiftKey ? -1 : 1) + controls.length) % controls.length;
      event.preventDefault();
      controls[next].focus();
    });
  }
</script>

<style>
  .publication-figure {
    min-width: 0;
    width: 100%;
    max-width: 32rem;
    margin: 0;
  }

  .publication-figure__thumbnail {
    display: block;
    background: #fff;
    border: 1px solid var(--line);
    color-scheme: light;
    text-decoration: none;
    cursor: zoom-in;
    transition: border-color var(--transition);
  }

  .publication-figure__matte {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: var(--figure-preview-ratio);
  }

  .publication-figure__thumbnail img {
    position: absolute;
    inset: 1rem;
    width: min(calc(100% - 2rem), var(--figure-native-width));
    height: calc(100% - 2rem);
    margin: auto;
    object-fit: contain;
  }

  .publication-figure__label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.6rem 0.85rem;
    color: var(--ink-muted);
    background: var(--surface);
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .publication-figure__label > span:first-child {
    font: 500 0.6875rem/1.5 var(--font-mono);
  }

  .publication-figure__enlarge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-hover);
    font-weight: 600;
  }

  .publication-figure__enlarge > span {
    font-size: 1rem;
  }

  .publication-figure__thumbnail:hover {
    border-color: var(--accent);
  }

  .publication-figure__thumbnail:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  figcaption {
    padding-top: 0.85rem;
  }

  .publication-figure__caption {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .publication-figure__credit {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--ink-quiet);
  }

  .publication-figure__credit summary {
    width: fit-content;
    min-height: 2.75rem;
    align-content: center;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25em;
  }

  .publication-figure__credit summary:hover {
    color: var(--accent-hover);
    text-decoration-color: currentColor;
  }

  .publication-figure__credit p {
    margin-bottom: 0.2rem;
  }

  .publication-figure__sources {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.2rem;
  }

  .publication-figure__sources a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.75rem;
    color: var(--accent-hover);
    font-size: 0.8125rem;
  }

  .figure-viewer {
    width: min(84rem, calc(100% - 3rem));
    max-width: none;
    max-height: calc(100dvh - 3rem);
    padding: 0;
    border: 1px solid var(--line);
    border-block-start: 2px solid var(--accent);
    border-radius: 0;
    color: var(--ink);
    background: var(--surface);
  }

  .figure-viewer::backdrop {
    background: rgb(18 24 24 / 64%);
  }

  :global(html:has(.figure-viewer[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  .figure-viewer__header {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .figure-viewer__header p {
    min-width: 0;
    max-width: 80ch;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .figure-viewer__number {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--accent-hover);
    font: 500 0.75rem/1.5 var(--font-mono);
  }

  .figure-viewer__header form {
    flex: 0 0 auto;
  }

  .figure-viewer__close {
    display: inline-flex;
    justify-content: center;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0.5rem;
    border: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    color: var(--ink-muted);
    font: 600 0.8125rem/1.3 var(--font-sans);
    cursor: pointer;
  }

  .figure-viewer__close:hover {
    color: var(--accent-hover);
    background: var(--surface-soft);
    border-color: var(--line);
  }

  .figure-viewer__close svg {
    flex: none;
  }

  .figure-viewer__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 19rem;
  }

  .figure-viewer__body > * {
    min-width: 0;
  }

  .figure-viewer__matte {
    display: grid;
    place-items: center;
    min-height: 24rem;
    padding: 1.5rem;
    background: #fff;
    color-scheme: light;
  }

  .figure-viewer__matte img {
    width: auto;
    height: auto;
    max-height: calc(100dvh - 12rem);
    object-fit: contain;
  }

  .figure-viewer__info {
    align-self: stretch;
    padding: 1.75rem 1.5rem;
    border-inline-start: 1px solid var(--line);
  }

  .figure-viewer__caption {
    font-size: 1.0625rem;
    font-weight: 550;
    line-height: 1.55;
  }

  .figure-viewer__credit {
    max-width: 95ch;
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--ink-quiet);
    line-height: 1.6;
  }

  .figure-viewer__info .publication-figure__sources {
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-block-start: 1px solid var(--line);
  }

  @media (max-width: 1040px) {
    .figure-viewer__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .figure-viewer__matte {
      min-height: 0;
    }

    .figure-viewer__matte img {
      max-height: 60dvh;
    }

    .figure-viewer__info {
      border-inline-start: 0;
      border-block-start: 1px solid var(--line);
    }

    .figure-viewer__info .publication-figure__sources {
      flex-direction: row;
      gap: 0 1.2rem;
      margin-top: 0.75rem;
    }
  }

  @media (max-width: 600px) {
    .figure-viewer {
      width: calc(100% - 1.5rem);
      max-height: calc(100dvh - 1.5rem);
    }

    .figure-viewer__header {
      align-items: flex-start;
      gap: 0.75rem;
      padding: 1rem;
    }

    .figure-viewer__header p {
      font-size: 0.875rem;
    }

    .figure-viewer__matte {
      padding: 0.75rem;
    }

    .figure-viewer__info {
      padding: 1.25rem;
    }

    .figure-viewer__caption {
      font-size: 1rem;
    }
  }
</style>
