---
interface Props { start?: string; end?: string; summers?: number[]; alumni?: boolean }
const { start, end, summers, alumni = false } = Astro.props;
const formatMonth = (value: string) => new Intl.DateTimeFormat("en-US", {
  month: "long", year: "numeric", timeZone: "UTC"
}).format(new Date(`${value}-01T00:00:00Z`));
---
{summers?.length ? (
  <span>{summers.map((year, index) => <>{index > 0 && ", "}<time datetime={String(year)}>Summer {year}</time></>)}</span>
) : start && end ? (
  <span><time datetime={start}>{formatMonth(start)}</time> – <time datetime={end}>{formatMonth(end)}</time></span>
) : start ? (
  <span><time datetime={start}>{formatMonth(start)}</time>{alumni && <> –<span class="membership-dates__note"> End date not recorded</span></>}</span>
) : end ? (
  <span><span class="membership-dates__note">Start date not recorded </span>– <time datetime={end}>{formatMonth(end)}</time></span>
) : null}

<style>
  .membership-dates__note {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
