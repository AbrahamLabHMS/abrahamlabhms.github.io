{
  "name": "abraham-lab-website",
  "version": "0.1.0",
  "private": true,
  "description": "Static Astro site for the Abraham Lab at Harvard Medical School.",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "security:check": "node scripts/validate-security.mjs",
    "build": "node scripts/validate-security.mjs && node scripts/validate-content.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "postbuild": "node scripts/validate-build.mjs && node scripts/validate-presentation.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "validate:content": "node scripts/validate-content.mjs",
    "check:publications": "node scripts/check-publication-updates.mjs",
    "check:links": "node scripts/check-external-links.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "visual:setup": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright npx playwright install chromium",
    "visual:review": "npm run build && npm run validate:content && node scripts/visual-review.mjs",
    "quality:setup": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright npx playwright install chromium firefox webkit",
    "quality:review": "npm run build && npm run validate:content && node scripts/quality-review.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^25.9.4",
    "parse5": "7.3.0",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.6",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "vite": "^8.0.13"
  }
}
